{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["event_id", "source_id", "event_type", "event_time", "location", "payload",
               "schema_version", "source_type", "seq"],
  "properties": {
    "event_id": {"type": "string"},
    "source_id": {"type": "string", "pattern": "^((veh|rsu|ev)-[0-9]{4}|rsu-[12])$"},
    "event_type": {"enum": ["position", "brake", "crash", "hazard", "density", "emergency", "collision_risk"]},
    "event_time": {"type": "string"},
    "location": {
      "type": "object", "required": ["segment_id", "rsu_id"],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
        "rsu_id": {"enum": ["rsu-1", "rsu-2"]},
        "lane": {"type": "integer"}, "x": {"type": "number"}, "y": {"type": "number"}
      }
    },
    "payload": {"type": "object"},
    "schema_version": {"const": "1.0"},
    "source_type": {"enum": ["vehicle", "rsu", "emergency_vehicle"]},
    "seq": {"type": "integer", "minimum": 0},
    "sim_time_s": {"type": "number"},
    "trace": {"type": "object"}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "brake"}}},
     "then": {"properties": {"payload": {"required": ["decel_mps2", "speed_before_mps"]}}}}
  ]
}
